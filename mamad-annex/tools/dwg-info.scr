(setvar "CMDECHO" 0)
(setvar "FILEDIA" 0)
(princ "\n---INFO---")
(princ (strcat "\nDWGNAME  : " (getvar "DWGNAME")))
(princ (strcat "\nINSUNITS : " (itoa (getvar "INSUNITS"))))
(princ (strcat "\nLUNITS   : " (itoa (getvar "LUNITS"))))
(princ (strcat "\nLUPREC   : " (itoa (getvar "LUPREC"))))
(princ (strcat "\nDIMSCALE : " (rtos (getvar "DIMSCALE") 2 3)))
(princ (strcat "\nLTSCALE  : " (rtos (getvar "LTSCALE") 2 3)))
(princ (strcat "\nEXTMIN   : " (rtos (car (getvar "EXTMIN")) 2 1) " , " (rtos (cadr (getvar "EXTMIN")) 2 1)))
(princ (strcat "\nEXTMAX   : " (rtos (car (getvar "EXTMAX")) 2 1) " , " (rtos (cadr (getvar "EXTMAX")) 2 1)))
(setq ss (ssget "_X"))
(princ (strcat "\nENTITIES : " (if ss (itoa (sslength ss)) "0")))
(setq n 0 tb (tblnext "LAYER" T))
(while tb (setq n (1+ n) tb (tblnext "LAYER")))
(princ (strcat "\nLAYERS   : " (itoa n)))
(setq n 0 tb (tblnext "BLOCK" T))
(while tb (setq n (1+ n) tb (tblnext "BLOCK")))
(princ (strcat "\nBLOCKS   : " (itoa n)))
(princ "\n---LAYOUTS---")
(foreach lay (layoutlist) (princ (strcat "\n  " lay)))
(princ "\n---END---")
(command "_.SAVEAS" "_DXF" "16" "C:/migun/tmp/P-001.dxf")
(command "_.QUIT" "_Y")
