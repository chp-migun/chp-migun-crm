(setvar "SECURELOAD" 0)
(setvar "CMDECHO" 0)
(setvar "FILEDIA" 0)
(load "C:/migun/repo/mamad-annex/lisp/migun.lsp")
(setvar "TILEMODE" 1)
(mg:mklayers)
(mg:style)
(princ "\n---CUT-TEST---")
(setq ss (ssget "_X" '((0 . "INSERT") (2 . "X2"))))
(princ (strcat "\ninjected selection: " (if ss (itoa (sslength ss)) "0")))
(setq r (mg:cutwin '(-10450.0 -30350.0) '(-9900.0 -29580.0)
                   '(-10150.0 -34800.0) 2.0 ss))
(princ (strcat "\nresult: " (if r "OK" "NIL")))
(if r (princ (strcat "\ntype/name: " (cdr (assoc 0 (entget r)))
                     " / " (cdr (assoc 2 (entget r))))))
(setq s2 (ssget "_X" '((0 . "INSERT") (2 . "MIGUN-CUT*"))))
(princ (strcat "\ncut inserts: " (if s2 (itoa (sslength s2)) "0")))
(if r (progn
  (setq d (entget r))
  (princ (strcat "\ninsert at: " (rtos (car (cdr (assoc 10 d))) 2 1)
                 "," (rtos (cadr (cdr (assoc 10 d))) 2 1)))
  (princ (strcat "\nxscale: " (rtos (cdr (assoc 41 d)) 2 2)))
  (princ (strcat "\nhas SPATIAL_FILTER: "
                 (if (dictsearch (cdr (assoc 360 (entget r))) "SPATIAL") "?" "see below")))))
(princ "\n---END-CUT-TEST---")
(command "_.SAVEAS" "" "C:/migun/tmp/cut-test.dwg")
(command "_.QUIT" "_Y")
